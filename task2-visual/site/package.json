    "build:offline": "vite build && node scripts/build-offline.mjs"
  },
  "dependencies": {
    "echarts": "^5.5.1"
  },
  "devDependencies": {
    "puppeteer-core": "^25.18.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
