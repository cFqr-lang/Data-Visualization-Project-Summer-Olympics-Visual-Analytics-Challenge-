{
  "name": "olympics-task2-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "任务二：百年奥运全景（Vite + TypeScript + Apache ECharts）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
