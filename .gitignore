# ---------------------------------------------------------------------------
# 数据文件：原始数据与中间数据不入库
# ---------------------------------------------------------------------------
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# 大体积数据格式统一忽略
*.csv
*.tsv
*.parquet
*.feather
*.xlsx
*.xls
*.zip
*.7z
*.tar.gz
*.sqlite
*.db

# 小型协作表允许提交
!contracts/**/*.csv
!shared/metrics/*.csv
!task1-data/contracts/*.csv
!task1-data/metrics/*.csv
!task2-visual/exports/tables/*.csv
!task3-insights/data/*.csv

