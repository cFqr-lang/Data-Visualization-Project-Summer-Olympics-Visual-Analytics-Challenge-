.env
.env.*
!.env.example
*.pem
*.key
*.pfx
secrets/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Node / Vite / 前端
# ---------------------------------------------------------------------------
node_modules/
.pnpm-store/
.yarn/
site/dist/
